---
import { getAllPosts, getPostSortDate, sortMDByDate } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { siteConfig } from "@/site-config";
import { withBase } from "@/utils/path";

const posts = sortMDByDate(await getAllPosts());
const groups = [
  { name: "Incident Reports", number: "01", slug: "incidents", subtitle: "Breach reviews & security failures", keywords: ["incident-analysis", "telecommunications", "banking"] },
  { name: "Security Engineering", number: "02", slug: "security", subtitle: "Trust, verification & remediation", keywords: ["patch-validation", "software-reliability", "security", "patch-management"] },
  { name: "Backend & Systems", number: "03", slug: "systems", subtitle: "Infrastructure, Java & production systems", keywords: ["java", "spring", "backend", "database", "system", "web", "authentication"] },
  { name: "Engineering Notes", number: "04", slug: "notes", subtitle: "Ideas, experiments & field notes", keywords: [] },
];
function category(tags: string[]) {
  const lower = tags.map(t => t.toLowerCase());
  if (groups[0].keywords.some(k => lower.includes(k))) return groups[0].name;
  if (groups[1].keywords.some(k => lower.includes(k))) return groups[1].name;
  if (groups[2].keywords.some(k => lower.some(t => t.includes(k)))) return groups[2].name;
  return groups[3].name;
}
const featured = posts[0];
const otherPosts = posts.slice(1);
const readable = (date: Date) => date.toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric", timeZone: "UTC" });
---

<PageLayout meta={{ title: "Home", description: siteConfig.description }}>
  <div class="journal">
    <div class="edition-top">
      <span>AN INDEPENDENT ENGINEERING JOURNAL</span>
      <span>EST. 2026 · ISSUE NO. 001</span>
    </div>
    <div class="masthead">
      <p class="ornament" aria-hidden="true">✦ &nbsp; ✧ &nbsp; ✦</p>
      <h1>There Is No River</h1>
      <p>Dispatches on software, security, and the systems between them.</p>
    </div>
    <div class="edition-line">
      <span>SOFTWARE · SECURITY · SYSTEMS</span>
      <span>NOTES FROM THE FIELD</span>
    </div>

    <section class="lead" aria-labelledby="latest">
      <div class="lead-content">
        <p class="folio">THE LEAD STORY <span>·</span> {featured ? readable(getPostSortDate(featured)) : "ARCHIVE"}</p>
        {featured && <>
          <h2 id="latest"><a href={withBase(`/posts/${featured.id}/`)}>{featured.data.title}</a></h2>
          <p class="lead-description">{featured.data.description}</p>
          <a class="read-story" href={withBase(`/posts/${featured.id}/`)}>Read the article <span aria-hidden="true">↗</span></a>
        </>}
      </div>
      <aside class="editorial-note">
        <span class="note-number">I.</span>
        <h3>Systems fail.<br/><em>Details matter.</em></h3>
        <p>A working notebook on engineering decisions, security trade-offs, and what happens when one change reaches another system.</p>
        <div class="note-sign">THE EDITOR'S NOTE</div>
      </aside>
    </section>

    <section class="sections" aria-labelledby="departments">
      <div class="section-heading"><span id="departments">THE DEPARTMENTS</span><span>FOUR FIELDS OF INQUIRY</span></div>
      <div class="department-grid">
        {groups.map((group) => {
          const count = posts.filter(p => category(p.data.tags ?? []) === group.name).length;
          return <a class="department" href={withBase(`/categories/${group.slug}/`)}>
            <span class="dept-number">NO. {group.number}</span>
            <h3>{group.name} <span aria-hidden="true">↗</span></h3>
            <p>{group.subtitle}</p>
            <span class="dept-count">{count} {count === 1 ? "ARTICLE" : "ARTICLES"}</span>
          </a>
        })}
      </div>
    </section>

    <section class="dispatches" aria-labelledby="dispatches-heading">
      <div class="section-heading"><span id="dispatches-heading">RECENT DISPATCHES</span><a href={withBase("/posts/")}>THE COMPLETE ARCHIVE ↗</a></div>
      <div class="article-list">
        {otherPosts.slice(0, 7).map((post, i) => <article class="dispatch">
          <div class="dispatch-index">{String(i + 2).padStart(2,"0")}</div>
          <div class="dispatch-main">
            <div class="dispatch-label">{category(post.data.tags ?? [])}</div>
            <h3><a href={withBase(`/posts/${post.id}/`)}>{post.data.title}</a></h3>
            <p>{post.data.description}</p>
          </div>
          <time datetime={getPostSortDate(post).toISOString()}>{readable(getPostSortDate(post))}</time>
        </article>)}
      </div>
      <a class="archive-button" href={withBase("/posts/")}>Browse all {posts.length} articles <span aria-hidden="true">→</span></a>
    </section>
  </div>
</PageLayout>

<style>
  .journal { --ink: hsl(var(--theme-text)); --muted: hsl(var(--theme-text-muted)); --accent: hsl(var(--theme-accent)); margin-top: -12px; }
  .edition-top,.edition-line,.section-heading { display:flex; justify-content:space-between; gap:16px; font-family:var(--font-sans); font-size:10px; font-weight:600; letter-spacing:.16em; color:var(--muted); }
  .edition-top { border-bottom:1px solid var(--ink); padding-bottom:11px; }
  .masthead { text-align:center; padding:29px 0 27px; }
  .ornament { color:var(--accent); font-size:15px; letter-spacing:.35em; margin:0 0 6px; }
  .masthead h1 { font-family:var(--font-serif); color:var(--ink); font-size:clamp(48px,9vw,85px); font-weight:500; letter-spacing:-.065em; line-height:.98; margin:0; }
  .masthead p:last-child { margin:18px auto 0; font-family:var(--font-serif); font-style:italic; font-size:17px; color:var(--muted); }
  .edition-line { padding:12px 0; border-top:3px double var(--ink); border-bottom:3px double var(--ink); }
  .lead { display:grid; grid-template-columns:minmax(0,1.75fr) minmax(195px,1fr); gap:30px; padding:43px 0 46px; border-bottom:1px solid var(--hairline); }
  .folio,.dept-number,.dispatch-label,.note-sign { font-family:var(--font-sans); text-transform:uppercase; letter-spacing:.15em; font-weight:650; font-size:10px; color:var(--accent); }
  .folio span { padding:0 8px; }
  .lead h2 { font-family:var(--font-serif); font-weight:500; font-size:clamp(31px,5vw,49px); line-height:1.08; letter-spacing:-.035em; margin:15px 0 18px; text-wrap:balance; }
  .lead h2 a:hover,.dispatch h3 a:hover { color:var(--accent); }
  .lead-description { color:var(--muted); font-size:17px; line-height:1.62; margin:0 0 22px; }
  .read-story { display:inline-block; border-bottom:1px solid var(--accent); padding-bottom:5px; font:600 11px var(--font-sans); letter-spacing:.08em; color:var(--accent); text-transform:uppercase; }
  .editorial-note { padding:22px 0 0 25px; border-left:1px solid var(--hairline); }
  .note-number { font:italic 29px var(--font-serif); color:var(--accent); }
  .editorial-note h3 { font-size:27px; letter-spacing:-.035em; line-height:1.18; font-weight:500; margin:14px 0 13px; }
  .editorial-note h3 em { color:var(--accent); }
  .editorial-note p { font-size:15px; line-height:1.63; color:var(--muted); }
  .note-sign { margin-top:26px; font-size:9px; }
  .sections,.dispatches { padding-top:39px; margin-bottom:50px; }
  .section-heading { padding-bottom:12px; border-bottom:1px solid var(--ink); align-items:center; }
  .section-heading a:hover { color:var(--accent); }
  .department-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); border-bottom:1px solid var(--hairline); }
  .department { display:flex; flex-direction:column; padding:24px 20px 25px 0; min-width:0; border-bottom:1px solid var(--hairline); }
  .department:nth-child(2n) { border-left:1px solid var(--hairline); padding-left:23px; }
  .department:nth-last-child(-n+2) { border-bottom:0; }
  .department h3 { font-size:clamp(22px,3vw,27px); font-weight:500; line-height:1.16; letter-spacing:-.025em; margin:11px 0 6px; }
  .department h3 span { color:var(--accent); font-family:var(--font-sans); font-size:16px; }
  .department:hover h3 { color:var(--accent); }
  .department p { color:var(--muted); font-size:14px; line-height:1.5; margin:0 0 20px; }
  .dept-count { font:600 10px var(--font-sans); letter-spacing:.14em; color:var(--muted); margin-top:auto; }
  .dispatch { display:grid; grid-template-columns:32px minmax(0,1fr) 95px; gap:16px; padding:22px 0; border-bottom:1px solid var(--hairline); }
  .dispatch-index { font:italic 20px var(--font-serif); color:var(--faint); }
  .dispatch h3 { font-size:23px; font-weight:500; line-height:1.22; letter-spacing:-.018em; margin:7px 0 7px; }
  .dispatch p { font-size:14px; color:var(--muted); line-height:1.5; margin:0; }
  .dispatch time { font:11px var(--font-sans); color:var(--muted); text-align:right; padding-top:4px; }
  .archive-button { display:flex; align-items:center; justify-content:space-between; gap:10px; padding:18px 0; margin-top:12px; border-top:2px solid var(--ink); border-bottom:1px solid var(--ink); font:600 12px var(--font-sans); letter-spacing:.08em; text-transform:uppercase; }
  .archive-button:hover { color:var(--accent); }
  @media(max-width:650px) {
    .edition-top,.edition-line { font-size:9px; letter-spacing:.08em; }
    .edition-top span:last-child,.edition-line span:last-child { display:none; }
    .masthead { padding:28px 0 23px; }
    .masthead h1 { font-size:clamp(43px,11vw,66px); }
    .masthead p:last-child { font-size:14px; }
    .lead { display:block; padding:28px 0; }
    .editorial-note { margin-top:31px; border-left:0; border-top:1px solid var(--hairline); padding:19px 0 0; }
    .editorial-note h3 { font-size:22px; }
    .department h3 { font-size:20px; }
    .department:nth-child(2n) { padding-left:14px; }
    .department { padding-right:10px; }
    .dispatch { grid-template-columns:24px minmax(0,1fr); gap:9px; }
    .dispatch h3 { font-size:20px; }
    .dispatch time { grid-column:2; text-align:left; padding-top:0; }
  }
</style>
